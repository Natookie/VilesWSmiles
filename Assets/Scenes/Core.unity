  m_Name: 
  m_EditorClassIdentifier: Nova::Nova.TMP.TextMeshProTextBlock
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Giovanna killed you the moment you learned the truth. It was quick, clean,
    and practiced. By the next morning, the bar had already returned to business
    as usual, as if you had never been there. The debt was never meant to be repaid.
    The loan, the job, and the promise of seeing your family again were all part
    of the same trap. You were never hired as an employee\u2014you were simply another
    investment waiting to be collected.\r\n\r\nYour family was never being kept somewhere
    safe. They had already been killed before your first shift, and their organs
    were sold long before yours. The hope of seeing them again was the only thing
    keeping you obedient. In the end, your body met the same fate. Your organs were
    harvested, your debt was marked PAID IN FULL, and another desperate person soon
    took your place behind the bar.\r\n\r\nVials W/ Smiles is built around two ideas:
    there is no such thing as a free lunch, and you are not the hero. Sometimes kindness
    is only bait, and sometimes the story doesn't end with justice. Sometimes, the
    system wins."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: abed1d5d166d3ce46bbc28e6de615dbe, type: 2}
  m_sharedMaterial: {fileID: -5734148071470767638, guid: abed1d5d166d3ce46bbc28e6de615dbe, type: 2}
